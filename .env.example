# Nova API — configure a server-side OpenAI-compatible provider.
# Never put provider credentials in VITE_* variables or frontend code.
NOVA_PROVIDER_API_KEY=
NOVA_PROVIDER_BASE_URL=https://api.openai.com/v1
NOVA_MODEL=gpt-4o-mini
PORT=8787

# Optional single-password protection for a private/publicly hosted workspace.
# When set, the browser requires this password before using Nova chat.
NOVA_APP_PASSWORD=
# Recommended: set a separate random secret (at least 32 characters) for signing sessions.
# If omitted, NOVA_APP_PASSWORD is used to sign the session cookie.
NOVA_SESSION_SECRET=

# Backwards-compatible aliases are also supported:
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
